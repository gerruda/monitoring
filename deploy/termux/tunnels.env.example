# Скопируй в ~/.monitoring/tunnels.env и поправь под себя:
#   cp deploy/termux/tunnels.env.example ~/.monitoring/tunnels.env
#
# SSH-ключ с телефона на VPS (один раз):
#   pkg install -y openssh
#   ssh-keygen -t ed25519 -C termux-monitoring
#   ssh-copy-id -p 22 user@VPS

# Куда подключаться (с телефона до VPS).
VPS_HOST=user@203.0.113.10
VPS_PORT=22

# Порты metrics-listener'ов ботов НА VPS (слушают 127.0.0.1:<port>).
# По умолчанию пробрасываем в ТАКОЙ ЖЕ локальный порт телефона, чтобы
# prometheus/targets/*.yml не пришлось менять.
#   9090 — health-check-in, 8080 — volna
# Если локальный порт занят (например, 8080 заняла llama), можно задать пару
# local:remote — но тогда поправь и соответствующий targets/<bot>.yml.
TUNNEL_PORTS="9090 8080"
